# Do not put real secrets in a committed .env file.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
ROSTER_RESNET_CHECKPOINT=/app/models/roster-resnet18.pt

# Optional persistent usage database location (default: data/api_usage.sqlite3)
# API_USAGE_DB=/absolute/path/api_usage.sqlite3

# Discord Developer Portal → Application → Bot → Token
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token

# Optional: reply only in this Discord channel. Leave blank to handle all allowed channels.
DISCORD_CHANNEL_ID=

# LINE Messaging API（LINE Developers Console 的 Messaging API channel）
LINE_CHANNEL_ACCESS_TOKEN=replace_with_your_line_channel_access_token
LINE_CHANNEL_SECRET=replace_with_your_line_channel_secret
# LINE 的圖片訊息只能讀取公開 HTTPS URL。設定為公開 Webhook 網址，例如 https://bot.example.com
LINE_PUBLIC_BASE_URL=
LINE_BOT_PORT=8080

# Cloudflare Zero Trust → Networks → Tunnels → your named tunnel → Docker.
# This token is used only by the production Docker deployment. Keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_your_cloudflare_tunnel_token

# V2 全員班表機器人（另一個 LINE 官方帳號／Messaging API channel，不要填 V1 的值）
LINE_V2_CHANNEL_ACCESS_TOKEN=replace_with_your_v2_channel_access_token
LINE_V2_CHANNEL_SECRET=replace_with_your_v2_channel_secret
# Cloudflare Tunnel 另開的 Public Hostname，例如 https://roster.example.com（必須是 https）
LINE_V2_PUBLIC_BASE_URL=
# 可選：指定模型；不填則用 models/all_staff/ 裡最新的 line-*/recognizer.pt
LINE_V2_RECOGNIZER=/app/models/all_staff/line-v3/recognizer.pt
# 可選：管理員的 LINE userId（U 開頭加 32 個十六進位字元；多位用逗號分隔）。不是加好友用的 LINE ID：
# 私訊機器人「我的ID」可以查到自己的。設定後，群組每張照片、每則航班人數訊息的辨識回報都會給管理員；
# 群組班表的日期也只有管理員能更正（推播開啟時，日期讀不到的群組班表會先問管理員，確認日期後才通知大家）。
# 留空＝沒有管理員（直接通知，並請上傳者更正）。
# 管理員也是「意見回饋」的收件人：同仁私訊「意見 內容」，在管理員下次使用時顯示（推播開啟時每天最多推播一次）。
# 管理員也能用「人員管理」；幹部（只能用「人員管理」：名冊、固定代號與幹部）不用填在這裡，第一批寫在 configs/officers.json，之後在 LINE 新增。
LINE_V2_ADMIN_USER_IDS=
# 可選：推播。預設關閉＝機器人完全不推播，不用每月的訊息額度（免費方案每月只有 200 則，每則 push 以收件人數計）：
# 要給某人的訊息（辨識回報、姓名申請與結果、給上傳者的提醒）放進他的收件匣，等他下次傳訊息時跟著回覆（免費）送出；
# 管理員選單的「辨識回報」或傳「收件匣」可以直接看。日期讀不到的群組班表直接發布，管理員在回報上補日期。
# 設成 1 改回推播。
LINE_V2_PUSH=
# 可選：自動通知（要 LINE_V2_PUSH=1 才會生效）。預設關閉＝群組有新班表時不私訊任何人，同仁自己按選單查（回覆不計訊息額度）。
# 設成 1 才會私訊已開通知的人；每人每張班表算 1 則 push，免費方案每月只有 200 則。
LINE_V2_NOTIFY=
